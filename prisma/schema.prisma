generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  CAPTURE
  DENY
  CANCEL
  EXPIRE
  FAILURE
  REFUND
  PARTIAL_REFUND
}

enum PaymentMethod {
  QRIS
  GOPAY
  DANA
  OVO
  SHOPEEPAY
  VIRTUAL_ACCOUNT
  BANK_TRANSFER
  CREDIT_CARD
  ALFAMART
  INDOMARET
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TransactionType {
  TOPUP
  REFUND
  ADJUSTMENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String?
  phone         String?   @unique
  avatar        String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  orders        Order[]
  activities    ActivityLog[]
  sessions      Session[]

  @@index([email])
  @@index([phone])
}

model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  role          UserRole  @default(ADMIN)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  activities    ActivityLog[]

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Game {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String
  banner      String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  orders      Order[]
  supplierMappings SupplierGameMapping[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id            String   @id @default(cuid())
  gameId        String
  name          String
  sku           String   @unique
  denomination  Int
  costPrice     Decimal  @db.Decimal(12, 2)
  sellPrice     Decimal  @db.Decimal(12, 2)
  margin        Decimal  @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  requiresZone  Boolean  @default(false)
  zoneLabel     String?  @default("Zone ID")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders        Order[]
  supplierMappings SupplierProductMapping[]

  @@index([gameId, isActive])
  @@index([sku])
}

model Supplier {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  baseUrl       String?
  apiKey        String?
  apiSecret     String?
  username      String?
  password      String?
  callbackUrl   String?
  status        SupplierStatus @default(ACTIVE)
  config        Json?
  isManual      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  gameMappings  SupplierGameMapping[]
  productMappings SupplierProductMapping[]
  transactions  SupplierTransaction[]

  @@index([code])
  @@index([status])
}

model SupplierGameMapping {
  id              String   @id @default(cuid())
  supplierId      String
  gameId          String
  supplierGameCode String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([supplierId, gameId])
}

model SupplierProductMapping {
  id                   String   @id @default(cuid())
  supplierId           String
  productId            String
  supplierProductCode  String
  supplierPrice        Decimal  @db.Decimal(12, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique @default(cuid())
  userId          String
  productId       String
  gameId          String
  userGameId      String
  userZoneId      String?
  quantity        Int          @default(1)
  unitPrice       Decimal      @db.Decimal(12, 2)
  totalPrice      Decimal      @db.Decimal(12, 2)
  status          OrderStatus  @default(PENDING)
  notes           String?
  supplierOrderId String?
  processedAt     DateTime?
  completedAt     DateTime?
  failedReason    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  game            Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  payment         Payment?
  supplierTransaction SupplierTransaction?

  @@index([userId, createdAt])
  @@index([orderNumber])
  @@index([status])
  @@index([gameId])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  paymentGateway        String
  gatewayTransactionId  String?
  paymentMethod         PaymentMethod?
  amount                Decimal       @db.Decimal(12, 2)
  fee                   Decimal       @db.Decimal(12, 2) @default(0)
  status                PaymentStatus @default(PENDING)
  gatewayResponse       Json?
  paidAt                DateTime?
  expiredAt             DateTime?
  callbackPayload       Json?
  signatureVerified     Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([gatewayTransactionId])
  @@index([status])
}

model SupplierTransaction {
  id              String       @id @default(cuid())
  orderId         String       @unique
  supplierId      String
  supplierOrderId String?
  requestPayload  Json
  responsePayload Json?
  status          OrderStatus  @default(PENDING)
  retryCount      Int          @default(0)
  lastAttemptAt   DateTime?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierOrderId])
  @@index([status])
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId String?
  eventType String
  payload   Json
  response  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([eventType])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  adminId   String?
  action    String
  entityType String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

model Setting {
  key         String   @id
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}