# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-generate-with-openssl-rand-base64-32

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://nexatopup:nexatopup_dev_password@localhost:5432/nexatopup?schema=public

# ===========================================
# REDIS (Rate limiting, sessions)
# ===========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# PAYMENT GATEWAY - MIDTRANS
# ===========================================
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=

# ===========================================
# PAYMENT GATEWAY - XENDIT (Alternative)
# ===========================================
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_IS_PRODUCTION=false

# ===========================================
# SUPPLIER - DIGIFLAZZ (Example)
# ===========================================
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_CALLBACK_URL=

# ===========================================
# EMAIL (Resend, SendGrid, SMTP)
# ===========================================
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com

# ===========================================
# STORAGE (Optional - for assets)
# ===========================================
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===========================================
# MONITORING (Optional)
# ===========================================
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=