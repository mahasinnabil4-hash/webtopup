NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-random-secret-generated-by-openssl

# Use only lowercase letters and numbers so it is safe in DATABASE_URL.
DB_PASSWORD=replace-with-a-long-random-hex-password

# Used once to create the initial admin account; remove both after seeding.
SEED_ADMIN_EMAIL=admin@your-domain.example
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password

MIDTRANS_SERVER_KEY=Mid-server-replace-me
MIDTRANS_CLIENT_KEY=Mid-client-replace-me
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=replace-me

# Optional supplier credentials. Configure these before enabling automatic fulfillment.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_CALLBACK_URL=

# Optional email settings.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
